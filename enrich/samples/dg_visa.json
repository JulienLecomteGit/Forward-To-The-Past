.net/00/43a5d806674e8782299d24db8329d0-100.png", "name": "Office Fran\u00e7ais de la Biodiversit\u00e9", "page": "https://www.data.gouv.fr/organizations/office-francais-de-la-biodiversite", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "office-francais-de-la-biodiversite", "uri": "https://www.data.gouv.fr/api/1/organizations/office-francais-de-la-biodiversite/"}, "owner": null, "role": "creator"}, {"contact_form": null, "email": "gregory.agin@ofb.gouv.fr", "id": "695da3000139d2f8f2842ecb", "name": "Gr\u00e9gory AGIN (Office fran\u00e7ais de la biodiversit\u00e9)", "organization": {"acronym": "OFB", "badges": [{"kind": "certified"}, {"kind": "public-service"}], "class": "Organization", "id": "5d7f937b8b4c4165718fbff1", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0-100.png", "name": "Office Fran\u00e7ais de la Biodiversit\u00e9", "page": "https://www.data.gouv.fr/organizations/office-francais-de-la-biodiversite", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "office-francais-de-la-biodiversite", "uri": "https://www.data.gouv.fr/api/1/organizations/office-francais-de-la-biodiversite/"}, "owner": null, "role": "rightsHolder"}], "created_at": "2024-11-12T00:00:00+00:00", "deleted": null, "description": "Le PNMGL souhaite se doter d\u2019un syst\u00e8me de surveillance de certains param\u00e8tres critiques de la qualit\u00e9 de l\u2019eau (turbidit\u00e9, concentration en chlorophylle-a) qui pourra alimenter \u00e0 terme un tableau de bord utile \u00e0 la gestion. Cette \u00e9tude men\u00e9e par i-Sea en 2024 vise donc \u00e0 prototyper une solution valorisant les donn\u00e9es satellitaires disponibles en open data (ESA Copernicus) et \u00e0 faire la d\u00e9monstration en conditions r\u00e9elles de sa plus-value par l\u2019analyse de l\u2019archive historique satellitaire.  \n\nAu cours de cette \u00e9tude, des anomalies de concentration en chlorophylle ont \u00e9t\u00e9 g\u00e9n\u00e9r\u00e9es sous format raster (GeoTIFF). Celles-ci repr\u00e9sentent l\u2019intensit\u00e9 de l\u2019\u00e9cart de la moyenne climatologique de concentration en chlorophylle d\u00e9riv\u00e9e des donn\u00e9es Copernicus Marine Service (CMEMS) sur l\u2019ensemble de la zone d\u2019\u00e9tude \u00e9largie autour de l\u2019emprise du PNMGL.  \n\nCette base de donn\u00e9es contient 7487 images raster d\u2019anomalie de concentration en chlorophylle entre janvier 2004 et juin 2024. \n\nNomenclature de la donn\u00e9e : phy_med_pnmgl_suivisat_CMEMS_YYYYMMDD_anomalie_CHL_isea_ofb_ras_32631.tif \n\nO\u00f9 YYYY = ann\u00e9e, MM = mois, DD = jour. CHL = concentration en chlorophylle.", "description_short": null, "doi": null, "extras": {"dcat": {"provenance": ["La d\u00e9tection d\u2019anomalies repose sur des climatologies quotidiennes glissantes (moyenne et \u00e9cart-type en \u00e9chelle logarithmique) calcul\u00e9es sur une p\u00e9riode de +/- 11 jours autour de la date cible sur +/- 2 ann\u00e9es autour de l\u2019ann\u00e9e cible. Les anomalies d\u00e9signent par pixel l\u2019intensit\u00e9 des \u00e9carts de l\u2019observation \u00e0 la climatologie, autrement dit \u00e9cart \u00e0 la moyenne divis\u00e9 par l\u2019\u00e9cart-type. On consid\u00e8re l\u2019anomalie comme significative \u00e0 partir d\u2019un \u00e9cart de 2.5 fois l\u2019\u00e9cart-type. Les anomalies sont d\u00e9finies en \u00e9chelle logarithmique afin de respecter la distribution log-normale des param\u00e8tres de qualit\u00e9 de l\u2019eau."], "spatial_resolution": "10 m"}, "ecologie:universe": true}, "featured": false, "frequency": "punctual", "frequency_date": null, "geopf": null, "harvest": {"backend": "CSW-ISO-19139", "created_at": "2024-11-12T00:00:00+00:00", "dct_identifier": "http://data.ofb.fr/2c217af3-c22f-4130-8cc0-1a1ed62a6dbd", "domain": "data.ofb.fr", "issued_at": "2024-11-12T00:00:00+00:00", "last_update": "2026-11-27T00:14:11.489000+00:00", "record_id": "e3b428e9-e139-46a2-810c-37f37eef68a7", "remote_id": "http://data.ofb.fr/2c217af3-c22f-4130-8cc0-1a1ed62a6dbd", "remote_url": "https://data.ofb.fr/catalogue/Donnees-geographiques-OFB/fre/catalog.search#/metadata/e3b428e9-e139-46a2-810c-37f37eef68a7", "source_id": "684af36aeb4fcb5ce4f438bc", "source_url": "https://data.ofb.fr/catalogue/Donnees-geographiques-OFB/fre/csw", "uri": "http://data.ofb.fr/2c217af3-c22f-4130-8cc0-1a1ed62a6dbd"}, "id": "6888c341441fa32e35cf50b9", "internal": {"created_at_internal": "2025-07-29T12:49:05.665000+00:00", "last_modified_internal": "2026-10-02T13:57:58.069000+00:00"}, "last_modified": "2026-10-02T13:57:58.069000+00:00", "last_update": "2026-10-02T13:57:58.069000+00:00", "license": "notspecified", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0}, "resources_downloads": 0, "reuses": 0, "reuses_by_months": {"2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0}, "views": 767}, "organization": {"acronym": "OFB", "badges": [{"kind": "certified"}, {"kind": "public-service"}], "class": "Organization", "id": "5d7f937b8b4c4165718fbff1", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0-100.png", "name": "Office Fran\u00e7ais de la Biodiversit\u00e9", "page": "https://www.data.gouv.fr/organizations/office-francais-de-la-biodiversite", "permissions": {"delete": false, "edit": false, 