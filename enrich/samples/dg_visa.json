{"data": [{"access_audiences": [], "access_type": "open", "access_type_reason": null, "access_type_reason_category": null, "acronym": null, "archived": null, "authorization_request_url": null, "badges": [], "contact_points": [], "created_at": "2022-09-02T10:40:04.079000+00:00", "deleted": null, "description": "Ce fichier recense tous les dossiers de visa d\u2019exploitation cin\u00e9matographique produits et d\u00e9livr\u00e9s par le CNC de 1945 \u00e0 nos jours. R\u00e9git par l'article L211-1 du Code du cin\u00e9ma et de l'image anim\u00e9e, le visa d'exploitation constitue une autorisation administrative n\u00e9cessaire pour toute \u0153uvre, fran\u00e7aise ou \u00e9trang\u00e8re, qui a pour vocation d'\u00eatre exploit\u00e9 commercialement dans les salles de cin\u00e9ma. Assurant la d\u00e9livrance de ce visa par le biais de sa commission de classification, le CNC contribue  de ce fait \u00e0 l'une de ses missions premi\u00e8res, \u00e0 savoir la r\u00e9gulation et le contr\u00f4le du secteur cin\u00e9matographique fran\u00e7ais. Aujourd\u2019hui, plus de 95 000 dossiers de visa d\u2019exploitation sont ainsi r\u00e9pertori\u00e9s dans ce fichier...\n", "description_short": null, "doi": null, "extras": {}, "featured": true, "frequency": "punctual", "frequency_date": "2022-09-02T00:00:00+00:00", "geopf": null, "harvest": null, "id": "6311c164ebfb165ddc828ded", "internal": {"created_at_internal": "2022-09-02T10:40:04.079000+00:00", "last_modified_internal": "2025-11-13T09:18:46.567000+00:00"}, "last_modified": "2025-11-13T09:18:46.567000+00:00", "last_update": "2025-11-13T09:18:46.563000+00:00", "license": "lov2", "metrics": {"dataservices": 1, "discussions": 0, "discussions_open": 0, "followers": 3, "followers_by_months": {"2024-11": 0, "2024-12": 0, "2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0}, "resources_downloads": 8240, "reuses": 1, "reuses_by_months"