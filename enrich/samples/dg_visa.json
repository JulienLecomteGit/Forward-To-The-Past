9d2f8f2842eab", "name": "Nicolas Durou (i-Sea)", "organization": {"acronym": "OFB", "badges": [{"kind": "certified"}, {"kind": "public-service"}], "class": "Organization", "id": "5d7f937b8b4c4165718fbff1", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0-100.png", "name": "Office Fran\u00e7ais de la Biodiversit\u00e9", "page": "https://www.data.gouv.fr/organizations/office-francais-de-la-biodiversite", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "office-francais-de-la-biodiversite", "uri": "https://www.data.gouv.fr/api/1/organizations/office-francais-de-la-biodiversite/"}, "owner": null, "role": "contact"}, {"contact_form": null, "email": "olivier.regniers@i-sea.fr", "id": "695da3000139d2f8f2842eb7", "name": "REGNIERS Olivier (i-Sea)", "organization": {"acronym": "OFB", "badges": [{"kind": "certified"}, {"kind": "public-service"}], "class": "Organization", "id": "5d7f937b8b4c4165718fbff1", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0-100.png", "name": "Office Fran\u00e7ais de la Biodiversit\u00e9", "page": "https://www.data.gouv.fr/organizations/office-francais-de-la-biodiversite", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "office-francais-de-la-biodiversite", "uri": "https://www.data.gouv.fr/api/1/organizations/office-francais-de-la-biodiversite/"}, "owner": null, "role": "creator"}, {"contact_form": null, "email": "gregory.agin@ofb.gouv.fr", "id": "695da3000139d2f8f2842ecb", "name": "Gr\u00e9gory AGIN (Office fran\u00e7ais de la biodiversit\u00e9)", "organization": {"acronym": "OFB", "badges": [{"kind": "certified"}, {"kind": "public-service"}], "class": "Organization", "id": "5d7f937b8b4c4165718fbff1", "logo": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0.png", "logo_thumbnail": "https://udata-avatars.s3.rbx.io.cloud.ovh.net/00/43a5d806674e8782299d24db8329d0-100.png", "name": "Office Fran\u00e7ais de la Biodiversit\u00e9", "page": "https://www.data.gouv.fr/organizations/office-francais-de-la-biodiversite", "permissions": {"delete": false, "edit": false, "harvest": false, "members": false, "private": false}, "slug": "office-francais-de-la-biodiversite", "uri": "https://www.data.gouv.fr/api/1/organizations/office-francais-de-la-biodiversite/"}, "owner": null, "role": "rightsHolder"}], "created_at": "2024-11-12T00:00:00+00:00", "deleted": null, "description": "Le PNMGL souhaite se doter d\u2019un syst\u00e8me de surveillance de certains param\u00e8tres critiques de la qualit\u00e9 de l\u2019eau (turbidit\u00e9, concentration en chlorophylle-a) qui pourra alimenter \u00e0 terme un tableau de bord utile \u00e0 la gestion. Cette \u00e9tude men\u00e9e par i-Sea en 2024 vise donc \u00e0 prototyper une solution valorisant les donn\u00e9es satellitaires disponibles en open data (ESA Copernicus) et \u00e0 faire la d\u00e9monstration en conditions r\u00e9elles de sa plus-value par l\u2019analyse de l\u2019archive historique satellitaire.  \n\nAu cours de cette \u00e9tude, des climatologies de turbidit\u00e9 ont \u00e9t\u00e9 g\u00e9n\u00e9r\u00e9es sous format raster (GeoTIFF). Celles-ci repr\u00e9sentent les statistiques climatologiques de turbidit\u00e9 (moyenne, \u00e9cart-type, percentile 95) d\u00e9riv\u00e9e des donn\u00e9es Copernicus Marine Service (CMEMS) sur l\u2019ensemble de la zone d\u2019\u00e9tude \u00e9largie autour de l\u2019emprise du PNMGL.  \n\nCette base de donn\u00e9es contient 36 images raster, 12 pour chacune des statistiques climatologiques mensuelles de turbidit\u00e9 (moyenne, \u00e9cart-type, percentile 95). \n\nNomenclature de la donn\u00e9e : phy_med_pnmgl_suivisat_sentinel3_climatologie_SSS_TUR_MM_isea_ofb_ras_32631.tif \n\nO\u00f9 SSS = statistique (moyenne, ecarttype, PC95) et MM = mois. TUR = turbidit\u00e9.", "description_short": null, "doi": null, "extras": {"dcat": {"provenance": ["Les statistiques de climatologies mensuelles (moyenne, \u00e9cart-type et percentile 95) ont \u00e9t\u00e9 calcul\u00e9es en compilant par mois sur toutes les ann\u00e9es (2017-2024) tous les produits de turbidit\u00e9 issus de la base de donn\u00e9es Sentinel-3."], "spatial_resolution": "300 m"}, "ecologie:universe": true}, "featured": false, "frequency": "punctual", "frequency_date": null, "geopf": null, "harvest": {"backend": "CSW-ISO-19139", "created_at": "2024-11-12T00:00:00+00:00", "dct_identifier": "http://data.ofb.fr/87dd5479-e0ef-4915-bd7d-7933ac022e07", "domain": "data.ofb.fr", "issued_at": "2024-11-12T00:00:00+00:00", "last_update": "2026-11-27T00:08:29.120000+00:00", "record_id": "a1307cab-0b83-4177-855d-ecafa23ce889", "remote_id": "http://data.ofb.fr/87dd5479-e0ef-4915-bd7d-7933ac022e07", "remote_url": "https://data.ofb.fr/catalogue/Donnees-geographiques-OFB/fre/catalog.search#/metadata/a1307cab-0b83-4177-855d-ecafa23ce889", "source_id": "684af36aeb4fcb5ce4f438bc", "source_url": "https://data.ofb.fr/catalogue/Donnees-geographiques-OFB/fre/csw", "uri": "http://data.ofb.fr/87dd5479-e0ef-4915-bd7d-7933ac022e07"}, "id": "6888c344441fa32e35cf50ba", "internal": {"created_at_internal": "2025-07-29T12:49:07.936000+00:00", "last_modified_internal": "2026-10-02T13:57:58.376000+00:00"}, "last_modified": "2026-10-02T13:57:58.376000+00:00", "last_update": "2026-10-02T13:57:58.376000+00:00", "license": "notspecified", "metrics": {"dataservices": 0, "discussions": 0, "discussions_open": 0, "followers": 0, "followers_by_months": {"2025-01": 0, "2025-02": 0, "2025-03": 0, "2025-04": 0, "2025-05": 0, "2025-06": 0, "2025-07": 0, "2025-08": 0, "2025-09": 0, "2025-10": 0, "2025-11": 0, "2025-12": 0, "2026-01": 0}, "resources_downloads